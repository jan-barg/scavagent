# Export these in your shell (the app does not read .env files). All are optional locally.

# Model (choice deferred). LiteLLM model string; Vertex uses gcloud Application Default Credentials.
SCAVAGENT_MODEL=vertex_ai/gemini-3.5-flash-lite
VERTEX_LOCATION=global
# Other models checked on Vertex in agentic-ai-msds (see docs/MODEL_COMPARISON.md), all with VERTEX_LOCATION=global
# unless noted: vertex_ai/claude-opus-5-5, vertex_ai/claude-sonnet-5-5 (need Claude quota),
# vertex_ai/gemini-3.5-flash, vertex_ai/moonshotai/kimi-k2-thinking-maas,
# vertex_ai/qwen/qwen3-235b-a22b-instruct-2507-maas, vertex_ai/openai/gpt-oss-120b-maas (us-central1).
# If the model can't answer (no credit, a rejected key, unreachable, still overloaded), this one answers instead,
# and the failed model is skipped for 5 minutes. Default Gemini 3.5 Flash-Lite; set it empty to turn this off.
# SCAVAGENT_FALLBACK_MODEL=vertex_ai/gemini-3.5-flash-lite
# Optional reasoning effort (low, medium, high). Claude models use medium when this is unset.
# SCAVAGENT_REASONING_EFFORT=medium

# Claude through Anthropic's own API instead of Vertex (no Vertex quota needed):
# SCAVAGENT_MODEL=anthropic/claude-opus-5-5   (or anthropic/claude-sonnet-5-5; VERTEX_LOCATION is ignored)
# Key from console.anthropic.com. Put the real value only in .env (ignored by Git and Docker), never here.
# ANTHROPIC_API_KEY=

# Storage: sqlite (local default), firestore (Cloud Run), or memory (tests).
SCAVAGENT_STORE=sqlite
SCAVAGENT_SQLITE_PATH=.data/scavagent.db
# Required when SCAVAGENT_STORE=firestore:
# SCAVAGENT_ASSET_BUCKET=your-photo-bucket
# SCAVAGENT_FIRESTORE_DATABASE=(default)

# Transit legs (Kyle's integrations/transit.py) use the Google Routes API. First match wins:
# an API key restricted to the Routes API, or Application Default Credentials billed to a project
# (on Cloud Run: the runtime service account's project, which must have routes.googleapis.com enabled).
# Without either, legs fall back to walking with a warning.
# GOOGLE_MAPS_API_KEY=your-routes-api-key
# SCAVAGENT_ROUTES_PROJECT=project-that-pays-for-routes
# SCAVAGENT_ROUTES_DAILY_LIMIT=500   # per process, per UTC day

# Development only: shows fixture camera positions in finder results (never capturable).
# SCAVAGENT_DEV_CAMERA_FIXTURES=1

# Development only: exposes load_dev_adventure, which loads labeled synthetic fixtures.
# SCAVAGENT_DEV_FIXTURES=1
