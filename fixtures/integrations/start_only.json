    {
      "name": "research_place",
      "args": {
        "place_id": "wiki:9238071",
        "focus": "history"
      },
      "result": {
        "ok": true,
        "data": {
          "place_id": "wiki:9238071",
          "name": "The El Dorado",
          "description": "Residential skyscraper in Manhattan, New York",
          "address": "300 Central Park West (aka 1-13 West 90th Street, 2-20 West 91st Street)",
          "lat": 40.78833333,
          "lon": -73.9675,
          "claims": [
            {
              "id": "claim_1",
              "text": "The El Dorado (also spelled the Eldorado) is a cooperative apartment building at 300 Central Park West, between 90th and 91st Streets adjacent to Central Park, on the Upper West Side of Manhattan in New York City, United States.",
              "source_title": "Wikipedia: The El Dorado",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_2",
              "text": "It was constructed from 1929 to 1931 and was designed by architect of record Margon & Holder and consulting architect Emery Roth in the Art Deco style.",
              "source_title": "Wikipedia: The El Dorado",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_3",
              "text": "The El Dorado consists of twin 12-story towers rising from a 17-story base.",
              "source_title": "Wikipedia: The El Dorado",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_4",
              "text": "The building is a contributing property to the Central Park West Historic District, a National Register of Historic Places–listed district, and is a New York City designated landmark.",
              "source_title": "Wikipedia: The El Dorado",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_5",
              "text": "By the late 1920s, high-rise apartment buildings were being developed on Central Park West in anticipation of the completion of the New York City Subway's Eighth Avenue Line, which opened in 1932.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_6",
              "text": "Central Park West was concurrently widened from 48 to 63 ft (15 to 19 m).",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_7",
              "text": "Under the Multiple Dwelling Act of 1929, this allowed the construction of proportionally taller buildings on the avenue.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_8",
              "text": "In March 1929, developer Frederick Brown acquired the original El Dorado Apartments, as well as eight adjacent row houses on 90th and 91st Streets.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_9",
              "text": "The assemblage measured 200 ft (61 m) long on Central Park West and 90th Street and 175 ft (53 m) long on 91st Street.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_10",
              "text": "Three weeks later, Brown resold the sites to Louis Klosk, a Bronx-based developer who planned to erect a similarly named 22-story apartment building at a cost of $8.5 million.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_11",
              "text": "Klosk hired Margon & Holder and Emery Roth to design the building, and the architects created multiple designs.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_12",
              "text": "Early plans called for a 16-story building with a streamlined base and a flat top.",
              "source_title": "Wikipedia: The El Dorado (section: History)",
              "source_url": "https://en.wikipedia.org/w/index.php?oldid=1373447224#History",
              "source_revised_at": "2026-09-06T01:37:31Z",
              "source_kind": "encyclopedia"
            },
            {
              "id": "claim_13",
              "text": "The LPC building database lists 300 Central Park West (aka 1-13 West 90th Street, 2-20 West 91st Street) (The Eldorado): architect/builder Margon & Holder and Emery Roth; primary style Art Deco; date 1930; historic district Upper West Side / Central Park West Historic District.",
              "source_title": "NYC LPC: Individual Landmark and Historic District Building Database (NYC Open Data)",
              "source_url": "https://data.cityofnewyork.us/d/gpmc-yuvp",
              "source_revised_at": null,
              "source_kind": "official_record"
            }
          ],
          "physical_features": [],
